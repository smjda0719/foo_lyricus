<?xml version="1.0" encoding="utf-8"?>
<!--
  Lyricus - foo_lyricus.dll

  设计说明：
  * 工具集固定 v145（本机只有 VS2026 这一套；SDK 自带工程写的是 v143，已实测需重定向）
  * WindowsTargetPlatformVersion = 10.0，即"使用已安装的最新 10.x SDK"（本机 10.0.26100.0）
  * 不通过 ProjectReference 引用 SDK 工程，而是直接链接预编译好的 .lib：
      - SDK 自带工程的包含目录没带 WTL，直接引用会编译失败
      - 直接链库可控、构建更快
    因此首次构建前需要先编出这些库，见 build-sdk.ps1
  * 目前只配置了 x64（SDK 的 Win32 库尚未编译）；要出 32 位时补 Win32 配置与对应库
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{7E3F1B4A-9C21-4E77-9E2B-3A5D6C8F0A11}</ProjectGuid>
    <RootNamespace>lyricus</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <LyricusRoot>$(ProjectDir)..</LyricusRoot>
    <SdkDir>$(LyricusRoot)\3rdparty\foobar2000</SdkDir>
    <!-- SDK 各库的输出目录形如  <proj>\<Platform>\<Configuration>\<name>.lib -->
    <SdkLibFlavor>$(Platform)\$(Configuration)</SdkLibFlavor>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <OutDir>$(LyricusRoot)\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(LyricusRoot)\intermediate\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>foo_lyricus</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <!-- SDK 头文件用了大量旧式写法，严格一致性模式会报错 -->
      <ConformanceMode>false</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <SDLCheck>true</SDLCheck>
      <!-- /utf-8: 源码是 UTF-8；/d2notypeopt: 官方 sample 也用它，配合 D2D -->
      <AdditionalOptions>/utf-8 /d2notypeopt %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(SdkDir);$(LyricusRoot)\3rdparty;$(LyricusRoot)\3rdparty\WTL\Include;$(LyricusRoot)\3rdparty\lunasvg\include;$(LyricusRoot)\3rdparty\lunasvg\plutovg\include;$(LyricusRoot)\3rdparty\columns_ui-sdk;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;_WINDLL;NDEBUG;_CRT_SECURE_NO_WARNINGS;LUNASVG_BUILD_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(SdkDir)\shared\shared-$(Platform).lib;$(SdkDir)\SDK\$(SdkLibFlavor)\foobar2000_SDK.lib;$(SdkDir)\foobar2000_component_client\$(SdkLibFlavor)\foobar2000_component_client.lib;$(LyricusRoot)\3rdparty\pfc\$(SdkLibFlavor)\pfc.lib;dwmapi.lib;crypt32.lib;d2d1.lib;dwrite.lib;windowscodecs.lib;shlwapi.lib;comctl32.lib;comdlg32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="..\src\main.cpp" />
    <ClCompile Include="..\src\debug_log.cpp" />
    <ClCompile Include="..\src\config.cpp" />
    <ClCompile Include="..\src\settings.cpp" />
    <ClCompile Include="..\src\prefs_page.cpp" />
    <ClCompile Include="..\src\lyric_search.cpp" />
    <ClCompile Include="..\src\folder_hint.cpp" />
    <!-- 歌词线索表的纯逻辑：文本表 <-> 内存表、增删查改、512 上限（hint 组）。 -->
    <ClCompile Include="..\src\folder_hint_table.cpp" />
    <ClCompile Include="..\src\hint_dialog.cpp" />
    <ClCompile Include="..\src\adjust_dialog.cpp" />
    <ClCompile Include="..\src\source_order.cpp" />
    <ClCompile Include="..\src\source_dialog.cpp" />
    <ClCompile Include="..\src\online_lyric.cpp" />
    <ClCompile Include="..\src\lyric.cpp" />
    <ClCompile Include="..\src\playback_state.cpp" />
    <ClCompile Include="..\src\control_window.cpp" />
    <!-- 控制条的布局数学：抽成纯函数是为了能进离线单测台（见 tests/harness 的 cbar 组）。 -->
    <ClCompile Include="..\src\control_bar_layout.cpp" />
    <!-- 首选项页的布局与配色：同样是纯函数，进离线单测台（run.ps1 的 prefs 组）。 -->
    <ClCompile Include="..\src\prefs_layout.cpp" />
    <!-- 色环取色器的纯逻辑：HSV 换算 + 几何 + 命中测试，进离线单测台（wheel 组）。 -->
    <ClCompile Include="..\src\color_wheel.cpp" />
    <!-- 颜色工具（BlendColor / ColorLuminance）：纯函数，四个自绘处共用同一份。 -->
    <ClCompile Include="..\src\color_util.cpp" />
    <!-- 自绘界面共用的小工具（圆角矩形/文字/字体/宿主主题）：两个自绘页面都要用。 -->
    <ClCompile Include="..\src\ui_draw.cpp" />
    <!-- 色环取色器窗口：位图 + 绘制 + 鼠标。换算在 color_wheel.cpp。 -->
    <ClCompile Include="..\src\color_picker.cpp" />
    <ClCompile Include="..\src\menu.cpp" />
    <ClCompile Include="..\src\initquit.cpp" />
    <ClCompile Include="..\src\svg_icon.cpp" />
    <ClCompile Include="..\src\lyrics_view.cpp" />
    <ClCompile Include="..\src\scroll_anim.cpp" />
    <ClCompile Include="..\src\dui_element.cpp" />
    <ClCompile Include="..\src\cui_panel.cpp" />
    <!-- libPPUI 的 WIN32_OP_FAIL()：ui_element_impl_withpopup 的 bump 路径要用到
         （bump → BumpableElem → CFlashWindow::ShowAbove → WIN32_OP）。
         该符号唯一实现在 libPPUI/win32_op.cpp；而 libPPUI 自己的 vcxproj 因为缺少
         WTL 包含路径编不出 .lib，所以把这一个源文件直接并进来 —— 它只依赖 pfc
         与 exception_win32，不需要 libPPUI 的其它源码。 -->
    <ClCompile Include="..\3rdparty\libPPUI\win32_op.cpp" />
    <!-- lunasvg：SVG 解析 + plutovg 光栅化。用通配符，避免逐个文件列清单。 -->
    <ClCompile Include="..\3rdparty\lunasvg\source\*.cpp" />
    <ClCompile Include="..\3rdparty\lunasvg\plutovg\source\*.c" />
    <!-- columns_ui-sdk：CUI 面板接口。基础 SDK 里没有，只能引这个（0BSD，锁了 commit）。 -->
    <ClCompile Include="..\3rdparty\columns_ui-sdk\*.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="..\src\svg_icon.h" />
    <ClInclude Include="..\src\lyrics_view.h" />
    <ClInclude Include="..\src\scroll_anim.h" />
    <ClInclude Include="..\3rdparty\lunasvg\include\*.h" />
    <ClInclude Include="..\3rdparty\lunasvg\source\*.h" />
    <ClInclude Include="..\3rdparty\lunasvg\plutovg\include\*.h" />
    <ClInclude Include="..\3rdparty\lunasvg\plutovg\source\*.h" />
    <ClInclude Include="..\src\stdafx.h" />
    <ClInclude Include="..\src\debug_log.h" />
    <ClInclude Include="..\src\config.h" />
    <ClInclude Include="..\src\lyric.h" />
    <ClInclude Include="..\src\playback_state.h" />
    <ClInclude Include="..\src\control_window.h" />
    <ClInclude Include="..\src\control_bar_layout.h" />
    <ClInclude Include="..\src\prefs_layout.h" />
    <ClInclude Include="..\src\prefs_page.h" />
    <ClInclude Include="..\src\dpi_util.h" />
    <ClInclude Include="..\src\color_wheel.h" />
    <ClInclude Include="..\src\color_util.h" />
    <ClInclude Include="..\src\folder_hint_table.h" />
    <ClInclude Include="..\src\ui_draw.h" />
    <ClInclude Include="..\src\color_picker.h" />
    <ClInclude Include="..\src\resource.h" />
  </ItemGroup>

  <!-- 首选项页的对话框资源。
       preferences_page_impl<TDialog> 要求对话框资源（见 helpers/atl-misc.h:271-280），
       所以本工程从这里开始有 .rc 了。 -->
  <ItemGroup>
    <ResourceCompile Include="..\src\lyricus.rc" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
