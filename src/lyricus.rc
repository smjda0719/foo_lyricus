// ---------------------------------------------------------------------------
// Lyricus 首选项页的对话框资源
//
// 用 UTF-8 + #pragma code_page(65001)：rc.exe 默认按系统代码页读源文件，
// 中文会乱码。这行是官方给的办法。
//
// 对话框必须是 WS_CHILD —— preferences_page_instance_impl 会断言这一点
//（helpers/atl-misc.h:277），因为它是被**嵌进**首选项窗口的，不是独立弹窗。
// ---------------------------------------------------------------------------

#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

// ---------------------------------------------------------------------------
// 「Lyricus」首选项页
//
// 【为什么是空的】这一页现在是**全自绘**的：对话框里一个控件都没有，
// 所有内容由 prefs_page.cpp 在 WM_PAINT 里画、在鼠标消息里处理。
//
// 起因：用户 2026-09-26 说「这个界面有点老旧，在 lyricus 那个二级界面实现
// 一个更现代化的面板」。旧版是 GROUPBOX 分组框 + 六个 62x14 的小色块按钮 +
// 系统 trackbar —— 控件长什么样由系统主题决定，改不动，所以才整页自绘。
//
// 尺寸只是"建议值"：布局全部按**实际客户区**算（见 prefs_layout.h），
// 所以宿主给多大就画多大，不依赖这里的数字精确。
// 253 x 185 dialog units ≈ 380 x 330 逻辑像素 @96dpi。
//
// ⚠️ STYLE 里必须保留 WS_CHILD —— preferences_page_instance_impl 会断言
//    （见 helpers/atl-misc.h:277）。也不能加 WS_CAPTION / DS_MODALFRAME。
// ---------------------------------------------------------------------------
// ⚠️ 尺寸是**对话框单位（DLU）**，不是像素，而且横纵的换算基数不同：
//      宽 253 DLU / 380 逻辑像素 = 0.666
//      高 185 DLU / 330 逻辑像素 = 0.561
//    所以高从 330 加到 596（外观预设区 + 控件配色区）时，是 596 * 0.561 = 334，
//    不能拿横向那个比例去乘 —— 那样会短掉一大截，下面几区直接看不见。
// WS_VSCROLL：页面比宿主给的容器高，内容得能滚（用户 2026-09-26 报
// 「加了这一项之后页面太长了，需要一个滚动条」）。SDK 的 preferences_page
// 不带任何滚动支持，所以这一条和配套的 WM_VSCROLL 都得自己来。
IDD_LYRICUS_PREFS DIALOGEX 0, 0, 253, 662
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_VSCROLL
FONT 9, "MS Shell Dlg", 400, 0, 0x86
BEGIN
END

// ---------------------------------------------------------------------------
// 「为这个文件夹指定歌词线索」
//
// 注意和上面那个的区别：这个是**独立弹窗**，样式里没有也不能有 WS_CHILD。
// （首选项页那个必须有 WS_CHILD，因为 preferences_page_instance_impl 会断言 ——
//   见 helpers/atl-misc.h:277。两者不能照抄。）
//
// 为什么这段值得存在：用户那批专辑一个标签都没打，%artist% 是占位符「?」，
// 只剩曲名一个搜索词 —— 实测「哀歌」的真答案（id=1333394828）连前 10 都进不去，
// 而「阿良良木健 哀歌」第 1 条就是它。所以必须让人工能补上这一个词。
// ---------------------------------------------------------------------------

IDD_LYRICUS_HINT DIALOGEX 0, 0, 250, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "指定歌词搜索线索"
FONT 9, "MS Shell Dlg", 400, 0, 0x86
BEGIN
    LTEXT           "文件夹：", -1, 7, 8, 34, 10
    LTEXT           "", IDC_LBL_FOLDER, 42, 8, 200, 10

    LTEXT           "歌手", -1, 7, 26, 30, 10
    EDITTEXT        IDC_EDIT_ARTIST, 42, 24, 200, 14, ES_AUTOHSCROLL

    LTEXT           "专辑", -1, 7, 44, 30, 10
    EDITTEXT        IDC_EDIT_ALBUM, 42, 42, 200, 14, ES_AUTOHSCROLL

    LTEXT           "歌手会直接进搜索词，并且参与结果核对；专辑只作为搜索的兜底词。\n留空表示不指定。两项都清空即删除这条线索。",
                    IDC_LBL_TITLE_HINT, 7, 62, 235, 30

    DEFPUSHBUTTON   "确定", IDOK, 132, 96, 55, 16
    PUSHBUTTON      "取消", IDCANCEL, 192, 96, 55, 16
END

// ---------------------------------------------------------------------------
// 「调节面板」
//
// 五条滑动条：歌词偏移（逐曲目）+ 字号 / 行数 / 行位置 / 不透明度（全局）。
// 拖动时**实时生效**，取消会把全部原值还回去。
//
// 【为什么合成一个面板】用户 2026-09-25 连着两次提这个方向：
//   「改成打开一个面板，通过滑动条调整。这么点太麻烦了。」
//   「也把字号，行数，行位置，透明度也这么改。透明度我记得有另外一个面板，
//     但是太深了不好找。」
// 这几个量的共同点是**要一边看面板一边调** —— 分开做四个面板反而更难找。
// 透明度那个首选项页仍然保留（那里还有配色），这里只是给它一个近路。
// ---------------------------------------------------------------------------

IDD_LYRICUS_ADJUST DIALOGEX 0, 0, 306, 192
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "调节面板"
FONT 9, "MS Shell Dlg", 400, 0, 0x86
BEGIN
    LTEXT           "曲目：", -1, 7, 8, 26, 10
    LTEXT           "", IDC_LBL_TRACK, 36, 8, 263, 10

    LTEXT           "歌词偏移", -1, 7, 28, 54, 10
    CONTROL         "", IDC_SLIDER_OFFSET, "msctls_trackbar32",
                    TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 64, 24, 130, 16
    LTEXT           "+0.0 秒", IDC_LBL_V_OFFSET, 198, 28, 50, 10

    LTEXT           "歌词字号", -1, 7, 50, 54, 10
    CONTROL         "", IDC_SLIDER_FONT, "msctls_trackbar32",
                    TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 64, 46, 130, 16
    LTEXT           "", IDC_LBL_V_FONT, 198, 50, 50, 10
    PUSHBUTTON      "-", IDC_BTN_FONT_DEC, 252, 47, 18, 14
    PUSHBUTTON      "+", IDC_BTN_FONT_INC, 274, 47, 18, 14

    LTEXT           "显示行数", -1, 7, 72, 54, 10
    CONTROL         "", IDC_SLIDER_SPAN, "msctls_trackbar32",
                    TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 64, 68, 130, 16
    LTEXT           "", IDC_LBL_V_SPAN, 198, 72, 50, 10

    LTEXT           "当前行位置", -1, 7, 94, 54, 10
    CONTROL         "", IDC_SLIDER_RATIO, "msctls_trackbar32",
                    TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 64, 90, 130, 16
    LTEXT           "", IDC_LBL_V_RATIO, 198, 94, 50, 10

    LTEXT           "面板不透明度", -1, 7, 116, 54, 10
    CONTROL         "", IDC_SLIDER_ADJ_ALPHA, "msctls_trackbar32",
                    TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 64, 112, 130, 16
    LTEXT           "", IDC_LBL_V_ALPHA, 198, 116, 50, 10

    LTEXT           "拖动任意一条，面板立刻跟着变 —— 看着调，满意了点确定。\n字号 / 行数 / 行位置 / 不透明度是全局的；歌词偏移只对当前曲目生效并记住。",
                    -1, 7, 136, 293, 24

    PUSHBUTTON      "偏移归零", IDC_BTN_OFFSET_ZERO, 7, 170, 58, 16
    PUSHBUTTON      "显示恢复默认", IDC_BTN_DISPLAY_DEF, 69, 170, 74, 16
    DEFPUSHBUTTON   "确定", IDOK, 192, 170, 52, 16
    PUSHBUTTON      "取消", IDCANCEL, 248, 170, 52, 16
END

// ---------------------------------------------------------------------------
// 「歌词源顺序」
//
// 起因见 resource.h 那段说明：网易云排第一、命中就收工，备用源在正常使用中
// 几乎永远跑不到。用户 2026-09-25 提的就是"给一个自定义顺序的面板"。
//
// 用普通 LISTBOX（不 owner-draw）：三行文字，勾/叉用字符表示就够了 ——
// owner-draw 要多写一个 WM_DRAWITEM 和一套配色，收益只是几个像素的对齐。
// ---------------------------------------------------------------------------

IDD_LYRICUS_SOURCES DIALOGEX 0, 0, 252, 184
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "歌词源顺序"
FONT 9, "MS Shell Dlg", 400, 0, 0x86
BEGIN
    LTEXT           "从上到下依次尝试，命中即停。想验证某个备用源，把它移到最前面。",
                    -1, 7, 7, 238, 20
    LISTBOX         IDC_LIST_SOURCES, 7, 28, 238, 86, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "上移", IDC_BTN_SRC_UP, 7, 120, 46, 16
    PUSHBUTTON      "下移", IDC_BTN_SRC_DOWN, 57, 120, 46, 16
    PUSHBUTTON      "启用 / 停用", IDC_BTN_SRC_TOGGLE, 107, 120, 64, 16
    PUSHBUTTON      "恢复默认", IDC_BTN_SRC_RESET, 175, 120, 70, 16

    // ⚠️ 这块提示文字的矩形**不许和下面的按钮重叠**（rc 里用 ; 注释，不是 //）。
    // 第一版是 y=141 高=24（141..165），按钮在 y=158（158..174）—— 重叠 7 个单位。
    // 症状很怪：**只有改顺序的时候**，确定/取消**只画出下半截**。
    // 原因：改顺序会调 SetDlgItemText 更新这行提示，而 Windows 只重画**这个
    // static 的矩形** —— 那一下把按钮的上半擦掉，按钮不在失效区里所以不会重画。
    // 首次整窗绘制按 z 序来，所以启动时一切正常，只有局部重画才露馅。
    LTEXT           "", IDC_LBL_SRC_HINT, 7, 137, 238, 18

    DEFPUSHBUTTON   "确定", IDOK, 133, 162, 52, 16
    PUSHBUTTON      "取消", IDCANCEL, 191, 162, 54, 16
END

// ---------------------------------------------------------------------------
// 「色环取色器」
//
// 用户 2026-09-26 看过系统取色对话框之后说「虽然稍微好点，但我还是想要类似色环的」。
// 和首选项页一样是**全自绘**：对话框里一个控件都没有，内容在 color_picker.cpp
// 里画；坐标 <-> 颜色的换算在 color_wheel.cpp（纯函数，可离线单测）。
//
// ⚠️ 这个是**独立弹窗**，所以样式里有 WS_POPUP | WS_CAPTION，
//    而且**不能**有 WS_CHILD —— 和上面首选项页那个正好相反（见它的说明）。
//
// 尺寸只是建议值，布局按实际客户区算（见 color_wheel.h）。
// 280 x 173 dialog units ≈ 420 x 312 逻辑像素 @96dpi。
// ---------------------------------------------------------------------------
IDD_LYRICUS_COLORWHEEL DIALOGEX 0, 0, 280, 173
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择颜色"
FONT 9, "MS Shell Dlg", 400, 0, 0x86
BEGIN
END